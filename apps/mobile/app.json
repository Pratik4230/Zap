{
  "expo": {
    "name": "Xaply",
    "slug": "xaply",
    "scheme": "xaply",
    "version": "1.0.0",
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#121212",
    "icon": "./assets/images/icon.png",
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "userInterfaceStyle": "dark",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#050505"
      },
      "package": "com.pratik4230.xaply",
      "googleServicesFile": "./google-services.json",
      "runtimeVersion": "1.0.0"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/icon-512.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-notifications",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ],
      "expo-system-ui",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "backgroundColor": "#050505",
          "imageWidth": 200,
          "dark": {
            "image": "./assets/images/splash-icon.png",
            "backgroundColor": "#050505"
          }
        }
      ],
      "expo-sharing",
      "expo-web-browser"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "abd39df3-9a1c-43d8-8dde-c11522a6b30d"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/abd39df3-9a1c-43d8-8dde-c11522a6b30d"
    },
    "ios": {
      "runtimeVersion": {
        "policy": "appVersion"
      },
      "bundleIdentifier": "com.pratik4230.xaply"
    }
  }
}
